# Optional overrides for operator-kernel-stage3-ops.service.
# Copy to operator-kernel-stage3-ops.env and adjust.

# Safe unattended default (no auto-apply)
# STAGE3_OPS_ARGS="--days 7 --delta-profile none"

# Example: run with dry-run profile selection
# STAGE3_OPS_ARGS="--days 7 --delta-profile top3"

# Example: run with approved apply profile (requires token policy)
# STAGE3_OPS_ARGS="--days 7 --delta-profile concept_only --apply-deltas --approval-token CHANGE_ME"

# Preferred notification routing lives in config/notify.json.
# Legacy compatibility webhook URL (deprecated):
# STAGE3_ALERT_WEBHOOK_URL="https://example.local/webhook"
